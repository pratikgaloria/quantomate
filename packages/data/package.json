{
  "name": "@quantomate/data",
  "version": "0.1.0",
  "description": "Historical price caching and data fetching layer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest --coverage --no-cache --passWithNoTests"
  },
  "dependencies": {
    "@quantomate/core": "file:../core",
    "@quantomate/db": "^0.1.0",
    "@quantomate/library": "file:../library",
    "kiteconnect": "^5.3.0",
    "yahoo-finance2": "^3.11.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/papaparse": "^5.5.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "src/__tests__/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "index.ts"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@quantomate/core$": "<rootDir>/../core/src",
      "^@quantomate/library$": "<rootDir>/../library/src"
    }
  }
}

