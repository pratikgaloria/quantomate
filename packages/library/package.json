{
  "name": "@quantomate/library",
  "version": "0.1.0",
  "description": "Indicators and Strategies library for Quantomate Research",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest --coverage --no-cache"
  },
  "keywords": [
    "stocks",
    "trading",
    "algorithm",
    "indicators",
    "strategies",
    "backtest"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@quantomate/core": "^0.1.0",
    "lodash": "^4.17.21"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "__tests__.*.(test|spec).ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "index.ts"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@quantomate/core$": "<rootDir>/../core/src"
    }
  }
}
