    {
      "id": "strong-pullback",
      "name": "Strong Pullback",
      "description": "Multi-timeframe strategy that looks for intraday pullbacks in a strong higher-timeframe trend. Checks daily trend (EMA50) and intraday alignment with VWAP and EMA20.",
      "parameters": [
        {
          "name": "emaPeriod",
          "type": "number",
          "default": 20,
          "min": 5,
          "max": 50,
