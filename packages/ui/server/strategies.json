{
  "strategies": [
    {
      "id": "golden-cross",
      "name": "Golden Cross",
      "description": "Buy when fast SMA crosses above slow SMA, sell when it crosses below",
      "parameters": [
        {
          "name": "fastPeriod",
          "type": "number",
          "default": 50,
          "min": 10,
          "max": 100,
          "description": "Fast SMA period"
        },
        {
          "name": "slowPeriod",
          "type": "number",
          "default": 200,
          "min": 50,
          "max": 300,
          "description": "Slow SMA period"
        },
        {
          "name": "direction",
          "type": "select",
          "default": "long",
          "options": [
            "long",
            "short",
            "both"
          ],
          "description": "Trading direction"
        }
      ]
    },
    {
      "id": "pivot-trend",
      "name": "Pivot Trend",
      "description": "Enter long when previous day's close is above pivot resistance (R), exit when below pivot support (S). Entry/exit at next day's open.",
      "parameters": [
        {
          "name": "direction",
          "type": "select",
          "default": "both",
          "options": [
            "long",
            "short",
            "both"
          ],
          "description": "Trading direction"
        }
      ]
    }
  ]
}