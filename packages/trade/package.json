{
  "name": "@quantomate/trade",
  "version": "0.1.0",
  "description": "Live trading and order execution package",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "daemon": "tsx src/daemon.ts",
    "cli": "tsx src/cli.ts",
    "test": "jest --coverage --no-cache"
  },
  "dependencies": {
    "@quantomate/core": "file:../core",
    "@quantomate/data": "file:../data",
    "@quantomate/db": "file:../db",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "npmlog": "^7.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.14",
    "@types/npmlog": "^7.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "src/__tests__/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "index.ts",
      "cli.ts",
      "daemon.ts"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@quantomate/core$": "<rootDir>/../core/src",
      "^@quantomate/library$": "<rootDir>/../library/src",
      "^@quantomate/data$": "<rootDir>/../data/src"
    }
  }
}
