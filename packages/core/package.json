{
  "name": "@quantomate/core",
  "version": "0.1.0",
  "description": "Quantomate Core Trading Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "__tests__.*.(test|spec).ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "index.ts"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ]
  }
}
